# Discord Developer Portal -> Bot token. Never commit your real token.
DISCORD_BOT_TOKEN=replace_me

# Supercell Brawl Stars developer API key. Never commit your real key.
BRAWL_STARS_API_TOKEN=replace_me

# Optional legacy single-guild bootstrap. For a public multi-server install, leave these blank;
# each guild administrator configures that guild with /configure_servers.
# If used, enter both IDs. They are not required for global command sync.
DISCORD_GUILD_ID=
QUEUE_CHANNEL_ID=
RESULT_CHANNEL_ID=

# Optional legacy single-guild defaults only. In public multi-server mode leave these blank;
# each guild administrator configures the protected target with /set_protected or /set_protected_id.
# The protected Discord account may lose a match, but the bot will never ban it.
PROTECTED_DISCORD_ID=
PROTECTED_BRAWL_TAG=

# Optional legacy destination defaults only. Public mode uses /configure_servers or /set_winner_server.
# Invite links are single-use; Discord still requires each winner to accept/join.
WINNER_GUILD_ID=
WINNER_INVITE_CHANNEL_ID=
# Optional trusted staff IDs in the destination server (comma-separated).
WINNER_SERVER_STAFF_IDS=

# The bot posts a new queue daily at this local time.
TIME_ZONE=Asia/Seoul
DAILY_OPEN_HOUR=18
DAILY_OPEN_MINUTE=0

# The bot is locked to Bounty for its 1v1 rules.
# Both tags must be the sole players on opposing teams in the same Bounty battle.
ALLOWED_MODES=bounty
MATCH_POLL_SECONDS=10
EVENT_SIZE=10

# Global SAFETY LOCK: true prevents real bans in every guild. Keep true while testing.
# After setting false and restarting, a server admin must separately opt in with
# /set_auto_ban enabled:true confirm:true for that guild.
DRY_RUN=true

# Persistent SQLite database; keep the data folder when updating/restarting the bot.
DATABASE_PATH=./data/brawl-bot.sqlite3
