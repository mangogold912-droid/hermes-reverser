# Discord Developer Portal -> Bot token. Never commit your real token.
DISCORD_BOT_TOKEN=replace_me

# Supercell Brawl Stars developer API key. Never commit your real key.
BRAWL_STARS_API_TOKEN=replace_me

# IDs are numeric Discord snowflakes. Enable Developer Mode in Discord to copy them.
DISCORD_GUILD_ID=123456789012345678
QUEUE_CHANNEL_ID=123456789012345678
# Optional; defaults to QUEUE_CHANNEL_ID.
RESULT_CHANNEL_ID=

# Protected Discord user and their fixed Brawl tag. Set both values together,
# or leave both empty and use /set_protected or /set_protected_id after startup.
# The protected Discord account may lose a match, but the bot will never ban it.
PROTECTED_DISCORD_ID=
PROTECTED_BRAWL_TAG=

# Optional destination server for people who beat the protected player.
# Alternatively, configure it after startup with /set_winner_server guild_id invite_channel_id.
# Invite links are single-use; Discord still requires each winner to accept/join.
WINNER_GUILD_ID=
WINNER_INVITE_CHANNEL_ID=
# Optional trusted staff IDs in the destination server (comma-separated).
WINNER_SERVER_STAFF_IDS=

# The bot posts a new queue daily at this local time.
TIME_ZONE=Asia/Seoul
DAILY_OPEN_HOUR=18
DAILY_OPEN_MINUTE=0

# The bot is locked to Bounty for its 1v1 rules.
# Both tags must be the sole players on opposing teams in the same Bounty battle.
ALLOWED_MODES=bounty
MATCH_POLL_SECONDS=10
EVENT_SIZE=10

# SAFETY: leave true while testing. This disables Discord bans and the local
# ID/tag ban list; configured destination invites and join checks still run.
DRY_RUN=true

# Persistent SQLite database; keep the data folder when updating/restarting the bot.
DATABASE_PATH=./data/brawl-bot.sqlite3
